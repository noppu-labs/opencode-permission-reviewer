    { "id": "b.03", "form": "env -S string that starts with an option", "command": "env -S -i rm -rf /", "reason": "destruction" },
    { "id": "b.04", "form": "env -S at the end of a cluster, then --", "command": "env -iS -- rm -rf /", "reason": "destruction" },
