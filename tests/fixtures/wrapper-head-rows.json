    { "id": "b.10", "form": "env -a takes a value", "command": "env -a x rm -rf /", "reason": "destruction" },
    { "id": "b.11", "form": "env --argv0 takes a value", "command": "env --argv0 x rm -rf /", "reason": "destruction" },
    { "id": "b.12", "form": "env -S string with -a", "command": "env -S '-a x rm -rf /'", "reason": "destruction" },
