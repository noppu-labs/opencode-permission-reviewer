    { "id": "b.15", "form": "env -S comment, then the operands", "command": "env -S '#' rm -rf /", "reason": "destruction" },
    { "id": "b.16", "form": "env -S words separated by \\_", "command": "env -S 'rm\\_-rf\\_/'", "reason": "destruction" },
    { "id": "b.17", "form": "env -S \\c ends the string, then the operands", "command": "env -S '\\c' rm -rf /", "reason": "destruction" },
    { "id": "b.18", "form": "harmless env -S comment twin", "command": "env -S '#' ls /" },
    { "id": "b.19", "form": "harmless env -a twin", "command": "env -a x ls /" }
