# dependencies
node_modules/

# local-only agent guardrails (private to this checkout, never publish)
AGENTS.md

# local agent plans and reports (kept in the checkout, never published)
/docs/superpowers/

# local tool state (OpenCode, agent workflows, code indexes)
.opencode/
.superpowers/
.gitnexus/
.codegraph/

# audit logs (never commit)
approval-reviewer-audit.jsonl
permission-reviewer-audit.jsonl
*-audit.jsonl

# env / secrets
.env
.env.*
!.env.example

# editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*.log
# Windows alternate data streams (download metadata)
*:Zone.Identifier

# build output (generated by tsdown; packaged at release time, not committed)
dist/
coverage/

# reference clones (e.g. codex) if placed inside the worktree
/codex

