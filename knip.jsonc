{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Files that run or ship without an import edge knip can follow. The bun, tsup, node and
  // github-actions plugins already cover the tsup entries, the bun test files, server.js and the
  // benchmark CLI.
  "entry": [
    // Shipped to hosts as-is (package.json "files").
    "rpc.js",
    "tui.tsx",
    // Copied raw to dist/tui by scripts/copy-tui.ts and loaded by the host as the TUI plugin.
    "src/tui.tsx",
    "scripts/*.ts",
    // Live harness, host fixtures and the compatibility matrix, run by hand or from CI.
    "tests/live-*.ts",
    "tests/fixtures/*.ts",
    "tests/compatibility/*.ts",
    "tests/compatibility/probe/index.js",
    // Benchmark `node --test` files and the helpers they spawn.
    "benchmarks/permission-reviewer/tests/*.mjs"
  ],
  "project": ["src/**", "tests/**", "scripts/**", "benchmarks/**/*.mjs"],
  // See docs/DEVELOPMENT.md, "Quality gates".
  "ignoreFiles": ["tests/live-fixture/**"],
  // System tools, not npm packages: uv runs pre-commit (package.json "check"), mkfifo builds a
  // named pipe in two tests.
  "ignoreBinaries": ["uv", "mkfifo"]
}
