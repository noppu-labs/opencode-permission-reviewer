{
  "name": "@noppu-labs/opencode-permission-reviewer",
  "version": "2.4.2",
  "description": "Policy-aware permission reviewer for OpenCode V1 and V2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tui": "./dist/tui/tui.tsx",
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js",
      "default": "./dist/rpc.js"
    },
    "./cli": {
      "types": "./dist/explain.d.ts",
      "import": "./dist/explain.js",
      "default": "./dist/explain.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "opencode-permission-reviewer": "dist/explain.js"
  },
  "files": [
    "server.js",
    "rpc.js",
    "tui.tsx",
    "dist/",
    "README.md",
    "MIGRATION.md",
    "CHANGELOG.md",
    "NOTICE",
    "LICENSE",
    "LICENSE-APACHE",
    "SECURITY.md"
  ],
  "license": "MIT AND Apache-2.0",
  "author": "cris005",
  "homepage": "https://github.com/noppu-labs/opencode-permission-reviewer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noppu-labs/opencode-permission-reviewer.git"
  },
  "bugs": {
    "url": "https://github.com/noppu-labs/opencode-permission-reviewer/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "ai-agent",
    "agent-safety",
    "auto-approval",
    "permission-management",
    "llm",
    "codex-guardian",
    "policy-as-code",
    "typescript",
    "bun"
  ],
  "engines": {
    "bun": ">=1.3.0",
    "opencode": ">=1.18.29 <2 || >=2.0.3 <3"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.29 <2",
    "@opencode/plugin": ">=2.0.3 <3"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@opencode-ai/plugin": "1.18.35",
    "@opencode/plugin": "2.0.26",
    "@types/bun": "^1.3.0",
    "@types/semver": "7.8.0",
    "jiti": "^2.7.0",
    "tsup": "^8.0.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "build": "tsup && bun scripts/copy-tui.ts",
    "test": "bun test",
    "test:stress": "bun test tests/stress.test.ts --timeout 30000",
    "test:package": "bun test tests/package-smoke.test.ts --timeout 120000",
    "test:coverage": "bun test --coverage --coverage-reporter lcov --coverage-dir ./coverage && bun scripts/check-coverage.ts",
    "check": "bun run build && uv run --frozen pre-commit run --all-files && bun test"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "@opencode/client": "2.0.26",
    "jsonc-parser": "3.3.1",
    "semver": "7.8.5",
    "@opentui/core": "0.5.11",
    "@opentui/solid": "0.5.11",
    "solid-js": "1.9.12",
    "zod": "4.6.5"
  }
}
