{
  "name": "@noppu-labs/opencode-permission-reviewer",
  "version": "3.3.1",
  "description": "Let OpenCode run unattended, securely: a System One or LLM reviewer answers permission prompts and asks you only when it should.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tui": "./dist/tui/tui.tsx",
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js",
      "default": "./dist/rpc.js"
    },
    "./cli": {
      "types": "./dist/explain.d.ts",
      "import": "./dist/explain.js",
      "default": "./dist/explain.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "opencode-permission-reviewer": "dist/explain.js"
  },
  "files": [
    "server.js",
    "rpc.js",
    "tui.tsx",
    "dist/",
    "README.md",
    "docs/MIGRATION.md",
    "CHANGELOG.md",
    "docs/NOTICE",
    "LICENSE",
    "docs/LICENSE-APACHE",
    "docs/SECURITY.md"
  ],
  "license": "MIT AND Apache-2.0",
  "author": "cris005",
  "homepage": "https://github.com/noppu-labs/opencode-permission-reviewer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noppu-labs/opencode-permission-reviewer.git"
  },
  "bugs": {
    "url": "https://github.com/noppu-labs/opencode-permission-reviewer/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-ai",
    "ai-agent",
    "coding-agent",
    "ai-coding-assistant",
    "agent-safety",
    "ai-safety",
    "guardrails",
    "llm-guardrails",
    "permissions",
    "permission-management",
    "auto-approval",
    "auto-approve",
    "tool-approval",
    "human-in-the-loop",
    "command-review",
    "shell-safety",
    "policy-as-code",
    "security",
    "llm",
    "codex-guardian",
    "typescript",
    "bun"
  ],
  "engines": {
    "bun": ">=1.3.14",
    "opencode": ">=1.18.29 <2 || >=2.0.22 <3"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.29 <2",
    "@opencode/plugin": ">=2.0.22 <3"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@opencode-ai/plugin": "1.19.5",
    "@opencode-ai/sdk": "1.19.5",
    "@opencode/plugin": "2.2.2",
    "@types/bun": "^1.3.0",
    "@types/semver": "7.8.0",
    "fta-cli": "3.1.0",
    "get-east-asian-width": "1.7.0",
    "knip": "6.43.0",
    "string-width": "8.3.0",
    "tsdown": "0.23.3",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "ip-address": "10.7.4",
    "toml": "5.0.1",
    "zod": "4.6.7"
  },
  "scripts": {
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "fta": "fta .",
    "knip": "knip",
    "audit": "bun audit --ignore GHSA-p6vx-979v-rg4c --ignore GHSA-jp82-f5mq-hwhp --ignore GHSA-97r2-qh9m-474h --ignore GHSA-wp97-x4hv-qvhp --ignore GHSA-7rv5-mrxv-xcr9 --ignore GHSA-9wx9-5pv9-3349",
    "build": "rm -rf dist && tsdown && bun scripts/copy-tui.ts",
    "test": "bun test",
    "test:stress": "bun test tests/stress.test.ts --timeout 30000",
    "test:package": "bun test tests/package-smoke.test.ts --timeout 120000",
    "test:coverage": "bun test --coverage --coverage-reporter lcov --coverage-dir ./coverage && bun scripts/check-coverage.ts",
    "docs:screens": "bun scripts/capture-tui.ts --all",
    "check": "bun run build && bun run typecheck && uv run --frozen pre-commit run --all-files && uv run --frozen pre-commit run --hook-stage manual gitleaks-tree --all-files && bun test"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "@opencode/client": "2.2.2",
    "jsonc-parser": "3.3.1",
    "semver": "7.8.5",
    "@opentui/core": "0.7.0",
    "@opentui/solid": "0.7.0",
    "solid-js": "1.9.12",
    "zod": "4.6.7"
  }
}
